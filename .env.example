# ==============================================================================
# Vaani — Environment Variables Configuration
# ==============================================================================

# 1. Google Gemini AI API Key (Server-Side)
# Required for real AI information extraction from speech transcripts.
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# 2. Supabase Configuration (Database Storage with Row Level Security)
# Create a free project at: https://supabase.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Note: Newer Supabase projects name this VITE_SUPABASE_PUBLISHABLE_KEY (either name works!)
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# 3. Supabase Backend / Service Role Key (Server-side only — NEVER in browser code)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 4. (Optional) Custom Supabase Edge Function Endpoint URL
# If deployed, set to your edge function url, e.g. https://your-project.supabase.co/functions/v1/extract-form
# When empty, the app uses the built-in server endpoint (/api/extract)
VITE_SUPABASE_EDGE_FUNCTION_URL=
